<% has_aside_blocks? = PageLive.Components.Area.area_has_blocks?(@page, :aside) %>
<% main_has_blocks? = PageLive.Components.Area.area_has_blocks?(@page, :main) %>

<Layouts.app
  context={@context}
  flash={@flash}
  tenant_context={@tenant_context}
  scope={@current_scope}
>
  <Layouts.space
    editing?={@editing?}
    presences={@presences}
    scope={@current_scope}
    view="wiki/home"
  >
    <:actions :if={@can_manage_page? and @editing_block_id == nil}>
      <%= if @editing? do %>
        <UI.button_ok phx-click="edit_mode:toggle" />
      <% else %>
        <UI.button_unlock phx-click="edit_mode:toggle" />
      <% end %>
    </:actions>

    <:aside>
      <PageLive.Components.Aside.sections
        author_membership={@author_membership}
        can_manage_page?={@can_manage_page?}
        current_scope={@current_scope}
        editing?={@editing?}
        node={@node}
        page={@page}
        page_topic_form={@page_topic_form}
        page_topic_options={@page_topic_options}
        page_topic_summaries={@page_topic_summaries}
        page_tree={@page_tree}
      />
    </:aside>

    <%= if assigns[:not_found_path] do %>
      <div class="card-body bg-base-200 rounded flex flex-col items-center gap-4 py-16">
        <div>Ooops...</div>
        <div class="font-bold">"{@not_found_path}"</div>
        <div>Could not be found</div>
      </div>
    <% else %>
      <section>
        <UI.page_head class="mx-2">
          <:prepend>
            <Components.Page.breadcrumbs
              class="mb-2 text-sm opacity-60"
              include_current?={false}
              node={@node}
              page_tree={@page_tree}
              scope={@current_scope}
              trailing_separator?
            />
          </:prepend>

          <UI.editable_zone
            data-testid="page-title-edit"
            editing?={@editing?}
            phx-click="page_rename:start"
            title={"Rename page \"#{@node.title}\""}
          >
            <div class="p-2">
              <UI.page_title class="flex items-center gap-2">
                <.icon name="hero-book-open-micro" class="opacity-30 size-5" />
                {@node.title}
              </UI.page_title>
            </div>
          </UI.editable_zone>
        </UI.page_head>

        <UI.editable_zone
          :if={@editing? or @page_topic_summaries != []}
          class="mb-12"
          editing?={@editing?}
          data-testid="page-topic-add"
          data-tip="Add topic"
          phx-click={JS.push("page_topic:add_start") |> UI.modal_open("page-topic-inline-modal")}
          title="Add topic"
        >
          <section
            data-testid="page-topics"
            class="p-2"
          >
            <div>
              <UI.panel_title>
                <.icon name="hero-tag-micro" class="opacity-70 size-4" />
                <span>Topics</span>
              </UI.panel_title>
            </div>
            <PageLive.Components.PageTopics.render
              can_manage_page?={@can_manage_page?}
              current_scope={@current_scope}
              editing?={@editing?}
              page_topic_edit_form={@page_topic_edit_form}
              page_topic_edit_tagging_id={@page_topic_edit_tagging_id}
              page_topic_form={@page_topic_form}
              page_topic_options={@page_topic_options}
              page_topic_summaries={@page_topic_summaries}
              layout="inline"
            />
          </section>
        </UI.editable_zone>

        <div class={[
          "[&>*]:max-w-[80ch]",
          has_aside_blocks? && "grid lg:grid-cols-[3fr_2fr] gap-4"
        ]}>
          <div>
            <div
              :if={@editing?}
              class="flex justify-center"
            >
              <Components.Block.AddBlockMenuButton.render
                event_open="block:add_start"
                position="top"
                class="mb-12 w-full"
              />
            </div>

            <PageLive.Components.Area.render
              area={:main}
              editing?={@editing?}
              editing_block_id={@editing_block_id}
              form_edit_block={@form_edit_block}
              locks={@locks}
              library_state={@library_state}
              node={@node}
              page={@page}
              page_tree={@page_tree}
              path={@path}
              scope={@current_scope}
            />

            <Components.Block.AddBlockMenuButton.render
              :if={@editing? and main_has_blocks?}
              event_open="block:add_start"
              position="bottom"
              class="mt-8 w-full"
            />
          </div>

          <PageLive.Components.Area.render
            :if={has_aside_blocks?}
            area={:aside}
            class={[
              "max-lg:border-t",
              "max-lg:border-base-content/30",
              "max-lg:pt-8",
              "max-lg:mt-8",
              "lg:border-l",
              "lg:pl-4",
              if(@editing?, do: "border-transparent", else: "border-base-content/20")
            ]}
            editing?={@editing?}
            editing_block_id={@editing_block_id}
            form_edit_block={@form_edit_block}
            locks={@locks}
            library_state={@library_state}
            node={@node}
            page={@page}
            page_tree={@page_tree}
            path={@path}
            scope={@current_scope}
          />
        </div>

        <PageLive.Components.LinkedCopy.form
          :if={@linked_copy_form}
          class="bg-base-200 rounded-box p-4 space-y-3"
          id="linked-copy-form"
          linked_copy_form={@linked_copy_form}
          linked_copy_error={@linked_copy_error}
          phx-submit="linked_copy:submit"
        />

        <.live_component
          :if={@block_history_placement}
          module={PageLive.Components.BlockHistory}
          id={"block-history-#{@block_history_placement.id}"}
          page_tree={@page_tree}
          placement={@block_history_placement}
          scope={@current_scope}
        />
      </section>
    <% end %>
  </Layouts.space>
</Layouts.app>

<%= if assigns[:not_found_path] == nil do %>
  <PageLive.Components.BlockInfoModal.render
    :if={@block_info_placement}
    author_membership={@block_info_author_membership}
    placement={@block_info_placement}
    scope={@current_scope}
  />

  <Components.Block.AddBlockMenuButton.modal_special_blocks
    event_cancel="block:add_cancel"
    id="add-block-dialog"
    library_types={@library_state.types}
    open?={@add_block_modal_open?}
    scope={@current_scope}
  />

  <PageLive.Components.LibraryEntries.modal
    actor_id={@current_scope.actor.id}
    admin?={@library_can_manage_types?}
    edit_error={@library_edit_error}
    membership_id={@tenant_context.current_membership && @tenant_context.current_membership.id}
    mode={@library_modal_mode}
    picker_entries={@streams.library_picker_entries}
    picker_form={@library_picker_form}
    selected_entry_id={@library_selected_entry_id}
    selected_playlist_video_id={@library_selected_playlist_video_id}
    selected_type_id={@library_selected_type_id}
    state={@library_state}
    topic_form={@library_topic_form}
    topics={@library_topics}
  />

  <Components.Modal.render
    cancel="page_rename:cancel"
    cancel_testid="page-rename-close"
    open?={@page_rename.form != nil}
    testid="page-rename-dialog"
  >
    <:title>Rename page</:title>

    <Components.Page.node_title_form
      action_label="Update"
      cancel_event="page_rename:cancel"
      cancel_testid="page-rename-cancel"
      event_submit="page_rename:submit"
      event_validate="page_rename:validate"
      form={@page_rename.form}
      testid_prefix="page-rename"
    />
  </Components.Modal.render>
<% end %>
