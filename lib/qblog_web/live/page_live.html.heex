<Layouts.app flash={@flash} scope={@current_scope}>
  <Layouts.group presences={@presences} scope={@current_scope} view="wiki">
    <%= if assigns[:not_found_path] do %>
      <div class="card-body bg-base-200 rounded flex flex-col items-center gap-4 py-16">
        <div>Ooops...</div>
        <div class="font-bold">"{@not_found_path}"</div>
        <div>Could not be found</div>
      </div>
    <% else %>
      <section class="relative space-y-12">
        <div
          :if={@can_manage_page?}
          class="sticky top-4 z-20 h-0 flex justify-end"
        >
          <div :if={@editing_block_id} class="">
            <button
              type="button"
              class={[
                "btn btn-sm btn-soft btn-circle",
                "hover:btn-error",
                "mr-2"
              ]}
              phx-click="edit_block_cancel"
              phx-value-block_id={@editing_block_id}
            >
              <.icon name="hero-x-mark-mini" />
            </button>

            <button
              type="submit"
              form={"edit-block-form-#{@editing_block_id}"}
              class={[
                "btn btn-sm btn-primary btn-circle",
                "mr-2"
              ]}
            >
              <.icon name="hero-check-mini" />
            </button>
          </div>

          <div
            :if={@editing? and is_nil(@editing_block_id)}
            class="flex justify-end"
          >
            <QblogWeb.Components.Block.AddBlockMenuButton.render
              id="add-block-dialog"
              class={[
                "btn btn-sm btn-circle hover:btn-primary",
                "border-l border-base-300",
                "mr-3"
              ]}
              event_cancel="add_block_modal_cancel"
              event_open="add_block_modal_open"
              event_position_select="add_block_position_select"
              open?={@add_block_modal_open?}
              position={@add_block_position}
              scope={@current_scope}
            />
          </div>

          <button
            :if={is_nil(@editing_block_id)}
            class={[
              "btn btn-sm btn-circle",
              "opacity-80 hover:opacity-100 transition",
              "mr-2",
              @editing? && "btn-primary opacity-100",
              !@editing? && "btn-neutral hover:btn-primary"
            ]}
            phx-click="toggle_edit_mode"
          >
            <.icon name="hero-pencil-square-mini" />
          </button>
        </div>

        <header class="space-y-1">
          <h1 class="text-2xl font-bold opacity-90 pr-12">{@node.title}</h1>
          <div class="text-sm opacity-60">page author: {@page.author |> to_string()}</div>
          <div class="text-sm opacity-60">
            inserted_at: {@page.inserted_at |> Utils.Time.relative()}
          </div>
        </header>

        <div class={[
          "grid gap-y-12 gap-x-8 sm:grid-cols-2"
        ]}>
          <div
            :for={placement <- @page.block_placements}
            class={[
              "col-span-1",
              placement.width == "full" && "sm:col-span-2"
            ]}
            id={"block-#{placement.block.id}"}
          >
            <div class="card-body py-0.5 px-0 ">
              <%= if @editing_block_id == placement.block.id do %>
                <QblogWeb.Components.Block.form
                  placement={placement}
                  form={@form_edit_block}
                  node={@node}
                  page_tree={@page_tree}
                  path={@path}
                  scope={@current_scope}
                  actions?={false}
                />
              <% else %>
                <QblogWeb.Components.Block.render
                  editing?={@editing?}
                  lock={@locks[placement.block.id]}
                  placement={placement}
                  node={@node}
                  page_tree={@page_tree}
                  path={@path}
                  scope={@current_scope}
                />
              <% end %>
            </div>
          </div>

          <div
            :if={Enum.empty?(@page.block_placements)}
            class={[
              "sm:col-span-2",
              "p-8",
              "rounded bg-base-300/30",
              "text-center"
            ]}
          >
            No blocks yet
          </div>
        </div>

        <.form
          :if={@linked_copy_form}
          for={@linked_copy_form}
          id="linked-copy-form"
          phx-submit="linked_copy_submit"
          class="bg-base-200 rounded-box p-4 space-y-3"
        >
          <.input field={@linked_copy_form[:block_id]} label="Block ID" phx-mounted={JS.focus()} />
          <input
            name={@linked_copy_form[:position].name}
            type="hidden"
            value={@linked_copy_form[:position].value}
          />

          <div :if={@linked_copy_error} class="text-error text-sm">{@linked_copy_error}</div>

          <div class="flex justify-end gap-2">
            <.button
              class="btn btn-ghost btn-sm"
              phx-click="linked_copy_cancel"
              type="button"
            >
              Cancel
            </.button>
            <.button class="btn btn-primary btn-sm" type="submit">Link block</.button>
          </div>
        </.form>

        <QblogWeb.PageLive.BlockInfoModal.render
          :if={@block_info_placement}
          placement={@block_info_placement}
          scope={@current_scope}
        />
      </section>
    <% end %>
  </Layouts.group>
</Layouts.app>
