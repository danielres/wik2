<Layouts.app
  context={@context}
  flash={@flash}
  tenant_context={@tenant_context}
  scope={@current_scope}
>
  <Layouts.space
    editing?={@editing?}
    presences={@presences}
    scope={@current_scope}
    view="wiki/home"
  >
    <:actions :if={@can_manage_page? and @editing_block_id == nil}>
      <%= if @editing? do %>
        <WikWeb.Components.Block.AddBlockMenuButton.render event_open="add_block_modal_open" />
        <UI.button_ok phx-click="toggle_edit_mode" />
      <% else %>
        <UI.button_unlock phx-click="toggle_edit_mode" />
      <% end %>
    </:actions>
    <:aside>
      <section data-testid="page-topics">
        <% relevancy_dimension = Dimensions.get!("page", "relevancy") %>
        <div class="mb-2 flex items-center justify-between gap-2">
          <UI.panel_title class="mb-0">Topics</UI.panel_title>

          <div>
            <UI.button_add_topic
              :if={@editing? and @can_manage_page? and @page_topic_options != []}
              data-testid="page-topic-add"
              data-tip="Add topic"
              phx-click="page_topic_add_start"
            />
          </div>
        </div>

        <div class="space-y-2" data-testid="page-topic-list">
          <div :if={@page_topic_summaries == []} class="text-sm opacity-50">
            No topics yet
          </div>

          <div
            :for={summary <- @page_topic_summaries}
            class="rounded-box bg-base-200 px-3 py-2"
            data-testid={"page-topic-#{summary.tag.id}"}
          >
            <div class="grid grid-cols-[1fr_auto] items-center gap-2">
              <.link
                navigate={~p"/#{@current_scope.tenant.slug}/topics/#{summary.tag.slug}"}
                class="truncate text-sm hover:underline"
              >
                {summary.tag.name}
              </.link>

              <div class="flex items-center gap-2">
                <span
                  :if={summary.count > 1}
                  class="badge badge-sm bg-base-300"
                  data-testid={"page-topic-count-#{summary.tag.id}"}
                >
                  {summary.count}
                </span>

                <button
                  :if={@editing? and summary.current_member_tagging}
                  type="button"
                  class={[
                    "btn btn-xs btn-circle btn-ghost text-error",
                    "opacity-50 hover:opacity-100 transition-opacity"
                  ]}
                  data-testid={"page-topic-remove-#{summary.tag.id}"}
                  phx-click="page_topic_remove"
                  phx-value-tag_id={summary.tag.id}
                >
                  <span class="sr-only">Remove topic</span>
                  <.icon name="hero-x-mark" class="size-3" />
                </button>
              </div>
            </div>

            <LevelMeter.render
              :if={summary.average_relevancy}
              dimension={relevancy_dimension}
              label={relevancy_dimension.label}
              level={summary.average_relevancy}
              testid={"page-topic-relevancy-#{summary.tag.id}"}
            />
          </div>
        </div>

        <UI.modal id="page-topic-modal" open?={@page_topic_form != nil}>
          <UI.modal_title>Add topic</UI.modal_title>

          <.form
            :if={@page_topic_form}
            for={@page_topic_form}
            id="page-topic-form"
            class="mt-4 space-y-4"
            data-testid="page-topic-form"
            phx-change="page_topic_validate"
            phx-submit="page_topic_submit"
          >
            <.input
              field={@page_topic_form[:tag_id]}
              label="Topic"
              options={Enum.map(@page_topic_options, &{&1.name, &1.id})}
              prompt="Select a topic"
              type="select"
            />

            <RangeInput.render
              field={@page_topic_form[:relevancy_level]}
              dimension={relevancy_dimension}
              label={relevancy_dimension.label}
              max_level={relevancy_dimension.max}
            />

            <div class="flex justify-end gap-2">
              <button
                type="button"
                class="btn btn-ghost btn-sm"
                data-testid="page-topic-cancel"
                phx-click="page_topic_cancel"
              >
                Cancel
              </button>
              <.button class="btn btn-accent btn-soft btn-sm" data-testid="page-topic-submit">
                Save
              </.button>
            </div>
          </.form>
        </UI.modal>
      </section>

      <section data-testid="page-backlinks">
        <UI.panel_title>Backlinks</UI.panel_title>
        <Components.Block.Types.Backlinks.render
          block={%{data: %{"title" => "Backlinks"}, type: :backlinks}}
          node={@node}
          page_tree={@page_tree}
          scope={@current_scope}
        />
      </section>

      <section>
        <UI.panel_title>Details</UI.panel_title>
        <div class={[
          "grid grid-cols-2 gap-x-4 gap-y-2 mt-0",
          "items-baseline",
          "text-sm"
        ]}>
          <div>
            Created:
          </div>
          <Components.Time.relative_and_precise datetime={@page.inserted_at} ago? />

          <div>
            By:
          </div>
          <div class="flex items-center gap-2">
            <Components.User.identity
              :if={@author_membership}
              avatar_size="xs"
              class="gap-2"
              link?={true}
              membership={@author_membership}
            />
          </div>
        </div>
      </section>
    </:aside>
    <%= if assigns[:not_found_path] do %>
      <div class="card-body bg-base-200 rounded flex flex-col items-center gap-4 py-16">
        <div>Ooops...</div>
        <div class="font-bold">"{@not_found_path}"</div>
        <div>Could not be found</div>
      </div>
    <% else %>
      <section>
        <Components.Block.AddBlockMenuButton.modal_special_blocks
          scope={@current_scope}
          event_cancel="add_block_modal_cancel"
          event_position_select="add_block_position_select"
          id="add-block-dialog"
          open?={@add_block_modal_open?}
          position={@add_block_position}
        />
        <UI.page_head class="mx-2">
          <:prepend>
            <Components.Page.breadcrumbs
              class="mb-2 text-sm opacity-60"
              include_current?={false}
              node={@node}
              page_tree={@page_tree}
              scope={@current_scope}
              trailing_separator?
            />
          </:prepend>

          <UI.page_title class="opacity-90 hover:opacity-100 transition-opacity">
            {@node.title}
          </UI.page_title>
        </UI.page_head>

        <div class={[
          "grid grid-cols-1 gap-4",
          has_area?(@page, :aside) && "md:grid-cols-[minmax(0,1fr)_18rem]"
        ]}>
          <PageLive.Components.Area.render
            area={:main}
            editing?={@editing?}
            editing_block_id={@editing_block_id}
            form_edit_block={@form_edit_block}
            locks={@locks}
            node={@node}
            page={@page}
            page_tree={@page_tree}
            path={@path}
            scope={@current_scope}
          />

          <PageLive.Components.Area.render
            :if={has_area?(@page, :aside)}
            area={:aside}
            class={[
              "md:border-l sm:pl-2 lg:pl-4",
              if(@editing?, do: "border-transparent", else: "border-base-content/10")
            ]}
            editing?={@editing?}
            editing_block_id={@editing_block_id}
            form_edit_block={@form_edit_block}
            locks={@locks}
            node={@node}
            page={@page}
            page_tree={@page_tree}
            path={@path}
            scope={@current_scope}
          />
        </div>

        <.form
          :if={@linked_copy_form}
          for={@linked_copy_form}
          id="linked-copy-form"
          phx-submit="linked_copy_submit"
          class="bg-base-200 rounded-box p-4 space-y-3"
        >
          <.input field={@linked_copy_form[:block_id]} label="Block ID" phx-mounted={JS.focus()} />
          <input
            name={@linked_copy_form[:position].name}
            type="hidden"
            value={@linked_copy_form[:position].value}
          />

          <div :if={@linked_copy_error} class="text-error text-sm">{@linked_copy_error}</div>

          <div class="flex justify-end gap-2">
            <.button
              class="btn btn-ghost btn-sm"
              phx-click="linked_copy_cancel"
              type="button"
            >
              Cancel
            </.button>
            <.button class="btn btn-primary btn-sm" type="submit">Link block</.button>
          </div>
        </.form>

        <PageLive.Components.BlockInfoModal.render
          :if={@block_info_placement}
          author_membership={@block_info_author_membership}
          placement={@block_info_placement}
          scope={@current_scope}
        />

        <.live_component
          :if={@block_history_placement}
          module={PageLive.Components.BlockHistory}
          id={"block-history-#{@block_history_placement.id}"}
          page_tree={@page_tree}
          placement={@block_history_placement}
          scope={@current_scope}
        />
      </section>
    <% end %>
  </Layouts.space>
</Layouts.app>
